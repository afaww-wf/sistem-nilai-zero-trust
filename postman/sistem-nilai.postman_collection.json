        {
          "name": "Login dosen1 (device benar)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status harus 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.collectionVariables.set(\"d1_token\", pm.response.json().access_token); }",
                  "if (pm.response.code === 200) { pm.collectionVariables.set(\"d1_refresh\", pm.response.json().refresh_token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Device-ID",
                "value": "dev-dosen-1"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
