{
  "name": "sistem-nilai-zero-trust",
  "version": "1.0.0",
  "private": true,
  "description": "Sistem Nilai dengan API Gateway sebagai Policy Enforcement Point (Zero Trust)",
  "scripts": {
    "seed": "node scripts/seed.js",
    "gateway": "node gateway/index.js",
    "nilai": "node service-nilai/index.js",
    "transkrip": "node service-transkrip/index.js",
    "start": "concurrently -n gateway,nilai,transkrip -c blue,green,yellow \"npm:gateway\" \"npm:nilai\" \"npm:transkrip\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.3",
    "jsonwebtoken": "^9.0.2"
  }
}
